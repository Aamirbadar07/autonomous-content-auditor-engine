# Option A: Google Cloud / Vertex AI (enterprise billing and quotas)
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Option B: Gemini Developer API (no GCP project needed).
# Comment out the three lines above and uncomment these two instead.
# GOOGLE_GENAI_USE_VERTEXAI=False
# GOOGLE_API_KEY=your-api-key

# Default Model Selection (Configured for Gemini 3.5 Flash)
MODEL_NAME=gemini-3.5-flash
LOG_LEVEL=INFO
